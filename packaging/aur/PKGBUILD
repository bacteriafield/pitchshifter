# Maintainer: bacteriafield <bacteriafield@users.noreply.github.com>
pkgname=pitchshifter-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Virtual vocal effects pedal inspired by the DigiTech Vocal 300"
arch=('x86_64')
url="https://github.com/bacteriafield/pitchshifter"
license=('MIT')
depends=('portaudio' 'gcc-libs' 'glibc')
optdepends=('lua54: front panel (pitchshifter-gui, also needs iuplua)')
provides=('pitchshifter')
conflicts=('pitchshifter')
source=("$url/releases/download/v$pkgver/pitchshifter-linux-x86_64.tar.gz")
sha256sums=('@SHA256_LINUX@')

package() {
  cd pitchshifter-linux-x86_64
  install -d "$pkgdir/usr"
  cp -R bin lib share "$pkgdir/usr/"
  install -Dm644 share/doc/pitchshifter/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
