#!/bin/sh
# PitchShifter front panel. Generated by CMake from src/gui/pitchshifter-gui.in.
# User presets are read from and saved to presets.txt in the current directory.
here=$(cd "$(dirname "$0")" && pwd)
for lua in @LUA_CANDIDATES@; do
    command -v "$lua" >/dev/null 2>&1 && break
done
LUA_CPATH="@PCORE_DIR@/?.so;${LUA_CPATH:-;;}"
export LUA_CPATH
exec "$lua" "@GUI_SCRIPT@" "$@"
